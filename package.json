{
  "name": "web-codexing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control your computer's Codex desktop chats from a lightweight web UI over LAN or your own Tailscale network.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/knownothing20/web-codexing.git" },
  "bugs": { "url": "https://github.com/knownothing20/web-codexing/issues" },
